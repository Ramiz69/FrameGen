        }
      }
    },
    "Add the target to Package.swift. Private hosts need credentials in ~/.netrc for SwiftPM to download the zip." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте цель в Package.swift. Чтобы SwiftPM мог скачать zip-архив с закрытого хоста, укажите учетные данные в ~/.netrc."
