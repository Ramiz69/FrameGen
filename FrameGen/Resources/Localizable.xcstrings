        }
      }
    },
    "Apps that embed the XCFramework can verify who built it. Apple requires signatures for commonly used SDKs. Signing needs a network connection for the timestamp." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения, в которые встроен XCFramework, смогут проверить, кто его собрал. Apple требует подпись для распространенных SDK. Для получения метки времени при подписи нужно подключение к сети."
          }
        }
      }
    },
    "Archive for %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архив для %@"
